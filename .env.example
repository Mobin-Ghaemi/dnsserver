# Development only. For a server set DEBUG=False and replace every placeholder.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=False
# Defaults to True when DEBUG=False. Keep True on a public server.
# DJANGO_SECURE_SSL_REDIRECT=True
# Optional HSTS policies; enable only after checking every affected subdomain.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Optional in development (SQLite is used when POSTGRES_HOST is empty).
POSTGRES_HOST=
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Must end with /api/v1. Leave blank for local draft-only mode.
PDNS_API_URL=
PDNS_API_KEY=
PDNS_SERVER_ID=localhost
# Optional local configuration path. With URL/key both blank, readable local
# /etc/powerdns/pdns.conf or /etc/pdns/pdns.conf is detected automatically.
PDNS_CONFIG_FILE=
DNS_AUTO_DISCOVERY=True
# Existing active staff username to own newly discovered zones; otherwise the
# administrator who starts discovery becomes their owner.
DNS_DISCOVERY_OWNER=
# These names must point at your authoritative DNS servers.
DNS_NAMESERVERS=ns1.melkata.ir,ns2.melkata.ir,ns1.ezfile.ir,ns2.ezfile.ir

# Accepted public NS pairs for the domain checker (independent of zone defaults).
DNS_CHECK_NS_GROUPS=ns1.melkata.ir,ns2.melkata.ir;ns1.ezfile.ir,ns2.ezfile.ir
# Optional single allowed group; overrides DNS_CHECK_NS_GROUPS when set.
DNS_CHECK_NAMESERVERS=
